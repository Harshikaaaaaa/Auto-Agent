# Never ship these into the build context / image.
node_modules
dist
coverage

# Secrets and local-only files. The image reads config from real environment
# variables (or a compose env_file), never from a baked-in .env.
.env
.env.local
.env.*.local

# Git and CI metadata.
.git
.github
.gitignore

# Local WhatsApp auth material — device-linked, must not be baked into an image.
server/.wa-auth

# Editor / OS cruft and docs not needed at runtime.
.DS_Store
*.log
*.bak
index.html.bak

# Tests and tooling configs are not needed in the runtime image (the build
# stage copies the whole tree, but excluding these keeps the context small).
**/__tests__
eslint.config.js
vitest.config.ts
.prettierrc.json
.prettierignore
