# AutoAgent configuration
#
# Copy to `.env.local` for local development, or inject these as real
# environment variables in production.
#
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: everything below is SERVER-SIDE ONLY and must never be exposed to
# the browser. Only variables prefixed with `VITE_` are compiled into the client
# bundle, and those must never hold a secret. `npm run build` is followed in CI
# by `scripts/assert-no-secrets-in-bundle.mjs`, which fails the build if any
# secret value ends up in dist/.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Server ----
NODE_ENV=development
PORT=3234

# Browser origins allowed to call this API (comma separated).
# A wildcard is not supported: the session cookie requires an explicit allowlist.
CORS_ALLOWED_ORIGINS=http://localhost:3233,http://127.0.0.1:3233

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Authentication ----
# Every API route except /healthz, /readyz and /api/auth/* requires a session.
# AUTH_ENABLED=false is for local development ONLY and is rejected when
# NODE_ENV=production, because these routes send email, post messages, and
# read saved workflows.
AUTH_ENABLED=true

# Operator password. Minimum 12 characters. Required when AUTH_ENABLED=true.
APP_PASSWORD=

# HMAC key for session cookies. Minimum 32 characters of high entropy.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every existing session (the break-glass control).
SESSION_SECRET=

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# Send the Secure cookie flag. Defaults to true when NODE_ENV=production and
# false otherwise, so plain-HTTP local development still works. Only override
# this if you know why you need to.
# SESSION_COOKIE_SECURE=true

# ---- Rate limiting (per client IP, per window) ----
RATE_LIMIT_WINDOW_MS=60000
# General API budget.
RATE_LIMIT_MAX=300
# Model calls cost money, so they get a tighter budget.
RATE_LIMIT_AI_MAX=30
# Login attempts, throttled to slow credential guessing.
RATE_LIMIT_AUTH_MAX=10
# Outbound message sends, to cap spam blast radius.
RATE_LIMIT_SEND_MAX=20

# ---- AI provider ----
# Which provider to use by default: openrouter | gemini | ollama
AI_PROVIDER=openrouter

# Upper bound on a single model call.
AI_REQUEST_TIMEOUT_MS=60000

# Allow the browser to request a different provider than AI_PROVIDER.
# Set to false to pin every request to AI_PROVIDER.
AI_ALLOW_CLIENT_PROVIDER_OVERRIDE=true

# ---- OpenRouter (required when AI_PROVIDER=openrouter) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# ---- Gemini (required when AI_PROVIDER=gemini) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Ollama (local; no credential needed) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:8b

# ---- Feature flags ----
# WhatsApp uses an unofficial client library and carries account-ban risk.
# Off by default; see Task 17 in the hardening plan.
WHATSAPP_ENABLED=false

# ---- Client (PUBLIC — compiled into the browser bundle) ----
# Google OAuth client id. Public by design: it is visible during the OAuth flow.
# The client SECRET is server-side only and is added in Task 13.
VITE_GOOGLE_CLIENT_ID=

# Only set this when the API is served from a different origin than the app.
# Leave empty for the normal same-origin deployment.
VITE_API_BASE_URL=
