# AutoAgent configuration
#
# Copy to `.env.local` for local development, or inject these as real
# environment variables in production.
#
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: everything below is SERVER-SIDE ONLY and must never be exposed to
# the browser. Only variables prefixed with `VITE_` are compiled into the client
# bundle, and those must never hold a secret. `npm run build` is followed in CI
# by `scripts/assert-no-secrets-in-bundle.mjs`, which fails the build if any
# secret value ends up in dist/.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Server ----
NODE_ENV=development
PORT=3234

# Browser origins allowed to call this API (comma separated).
# A wildcard is not supported: the session cookie requires an explicit allowlist.
CORS_ALLOWED_ORIGINS=http://localhost:3233,http://127.0.0.1:3233

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Authentication ----
# Every API route except /healthz, /readyz and /api/auth/* requires a session.
# AUTH_ENABLED=false is for local development ONLY and is rejected when
# NODE_ENV=production, because these routes send email, post messages, and
# read saved workflows.
AUTH_ENABLED=true

# Operator password. Minimum 12 characters. Required when AUTH_ENABLED=true.
APP_PASSWORD=

# HMAC key for session cookies. Minimum 32 characters of high entropy.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every existing session (the break-glass control).
SESSION_SECRET=

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# Send the Secure cookie flag. Defaults to true when NODE_ENV=production and
# false otherwise, so plain-HTTP local development still works. Only override
# this if you know why you need to.
# SESSION_COOKIE_SECURE=true

# ---- Rate limiting (per client IP, per window) ----
RATE_LIMIT_WINDOW_MS=60000
# General API budget.
RATE_LIMIT_MAX=300
# Model calls cost money, so they get a tighter budget.
RATE_LIMIT_AI_MAX=30
# Login attempts, throttled to slow credential guessing.
RATE_LIMIT_AUTH_MAX=10
# Outbound message sends, to cap spam blast radius.
RATE_LIMIT_SEND_MAX=20

# ---- AI provider ----
# Which provider to use by default: openrouter | gemini | ollama
AI_PROVIDER=openrouter

# Upper bound on a single model call.
AI_REQUEST_TIMEOUT_MS=60000

# Allow the browser to request a different provider than AI_PROVIDER.
# Set to false to pin every request to AI_PROVIDER.
AI_ALLOW_CLIENT_PROVIDER_OVERRIDE=true

# ---- OpenRouter (required when AI_PROVIDER=openrouter) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# ---- Gemini (required when AI_PROVIDER=gemini) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Ollama (local; no credential needed) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:8b

# ---- Database (MySQL) ----
# Saved workflows live in MySQL. The server refuses to start if it cannot
# prepare the schema, because every workflow route depends on it.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# REQUIRED when NODE_ENV=production. An empty password is tolerated only for a
# local development server.
DB_PASSWORD=
DB_NAME=autoagent
DB_CONNECTION_LIMIT=10

# Require TLS to the database. Enforced in production whenever DB_HOST is not
# local, since otherwise workflow contents travel unencrypted.
DB_SSL=false

# Opt out of the production TLS-to-database requirement for a database reached
# only over a trusted private network (the Docker Compose stack sets this,
# because the db container's port is never published). Leave false for anything
# that crosses an untrusted network — use DB_SSL there instead.
DB_TRUST_PRIVATE_NETWORK=false

# Create/upgrade the schema on boot. Convenient for local development and a
# single-container deployment. Set to false to run migrations as a separate
# deployment step instead.
DB_AUTO_MIGRATE=true

# Database used by the integration tests. They skip when MySQL is unreachable.
TEST_DB_NAME=autoagent_test

# ---- Feature flags ----
# WhatsApp uses an unofficial client library and carries account-ban risk.
# Off by default; see Task 17 in the hardening plan.
WHATSAPP_ENABLED=false

# Tier-2 JavaScript rendering for the web-fetch node. When on, a page that the
# plain fetch gets back as an empty JS shell (e.g. a React/Next.js SPA) is
# re-fetched with a headless browser so its client-rendered content is visible
# to the scraper. Every navigation and subresource the browser makes is still
# checked against the same SSRF policy as the plain fetch. Off by default: it is
# slower and heavier. The container image already includes Chromium.
FETCH_RENDER_ENABLED=false
# Max JSON request body the API accepts (express/bytes size string). Large so a
# workflow can pass a whole scraped page to an AI node without a "too large"
# rejection; the only real ceiling left is the AI provider's own token limit.
# JSON_BODY_LIMIT=50mb
# FETCH_RENDER_TIMEOUT_MS=20000
# FETCH_RENDER_SETTLE_MS=1500
# Rendered SPAs are much larger than raw HTML, so the render tier has its own,
# bigger size cap (the extractor keeps only the readable text). Default 10 MB.
# FETCH_RENDER_MAX_BYTES=10000000

# ---- Connected tools: Google OAuth (SERVER-SIDE ONLY) ----
# Set all three together, or leave all three unset to disable connecting Gmail,
# Sheets and Drive. A partial configuration is rejected at startup, because the
# connect button would appear and then fail at the token exchange.
#
# Create an OAuth 2.0 "Web application" client in the Google Cloud console and add
# GOOGLE_OAUTH_REDIRECT_URI to its Authorised redirect URIs, verbatim.
#
# NOTE: VITE_GOOGLE_CLIENT_ID is gone. The browser used to run the OAuth flow
# itself and keep the resulting access token in localStorage. The server now runs
# the authorization-code flow, holds the refresh token, and proxies the API calls,
# so nothing Google-related is compiled into the bundle.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3234/api/oauth/google/callback

# Encrypts stored OAuth tokens at rest, so a database dump contains no usable
# Google credentials. Required whenever the three variables above are set.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ROTATING THIS makes every stored connection undecryptable — all tools must be
# reconnected.
CREDENTIAL_SECRET=

# Longest a single proxied Google API call may take, and the per-window budget.
GOOGLE_API_TIMEOUT_MS=30000
RATE_LIMIT_GOOGLE_MAX=120

# ---- Client (PUBLIC — compiled into the browser bundle) ----

# Only set this when the API is served from a different origin than the app.
# Leave empty for the normal same-origin deployment.
VITE_API_BASE_URL=
