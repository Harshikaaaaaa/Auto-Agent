{
  "name": "auto-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "server": "node server/api.js",
    "whatsapp": "node server/api.js"
  },
  "dependencies": {
    "@google/genai": "1.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jszip": "^3.4.0",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.6",
    "expr-eval": "2.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "0.463.0",
    "mysql2": "3.24.4",
    "ollama": "^0.6.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reactflow": "11.11.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.70.0",
    "vite": "^6.2.0",
    "vite-node": "^5.3.0",
    "vitest": "5.0.1"
  }
}
